{
  "name": "vue-vapor-a11y-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-sources.mjs",
    "dev:classic": "vite --config apps/classic/vite.config.mjs",
    "dev:vapor": "vite --config apps/vapor/vite.config.mjs",
    "build:classic": "vite build --config apps/classic/vite.config.mjs",
    "build:vapor": "vite build --config apps/vapor/vite.config.mjs",
    "build": "pnpm run build:classic && pnpm run build:vapor",
    "preview:classic": "vite preview --config apps/classic/vite.config.mjs",
    "preview:vapor": "vite preview --config apps/vapor/vite.config.mjs",
    "typecheck": "vue-tsc -p tsconfig.json",
    "verify": "node scripts/verify-vapor-mode.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "playwright test",
    "diff": "node scripts/diff-snapshots.mjs",
    "check": "pnpm run sync && pnpm run typecheck && pnpm run build && pnpm run verify && pnpm run smoke && pnpm run test:e2e && pnpm run diff"
  },
  "dependencies": {
    "vue": "3.6.0-rc.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.11"
  }
}
